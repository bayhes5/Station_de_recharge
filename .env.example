# Docker local: mqtt. Broker Raspberry: IP Wi-Fi du Raspberry, ex. 172.20.10.14.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_BASE_TOPIC=station
MQTT_BACKEND_CLIENT_ID=station-backend
MQTT_RASPBERRY_CLIENT_ID=raspberry-kiosk
# Compte broker du backend / bridge MQTT. En dev, laisser vide avec mosquitto.conf.
MQTT_USERNAME=
MQTT_PASSWORD=
# Compte broker du Raspberry. En production, utiliser un compte distinct
# limite aux topics de commande et d'ACK, par exemple raspberry_kiosk.
MQTT_RASPBERRY_USERNAME=raspberry_kiosk
MQTT_RASPBERRY_PASSWORD=change-me-raspberry-mqtt-password
MQTT_TLS_ENABLED=False
MQTT_TLS_CA_CERT=

# Web sémantique / SPARQL en développement uniquement.
SEMANTIC_DEV_ENDPOINTS_ENABLED=False
MQTT_QOS=1
MQTT_BRIDGE_HEARTBEAT_FILE=/tmp/mqtt_bridge_heartbeat
MQTT_BRIDGE_CONNECT_RETRY_SECONDS=5
MQTT_BRIDGE_HEARTBEAT_INTERVAL_SECONDS=10
MQTT_BRIDGE_HEARTBEAT_MAX_AGE_SECONDS=30
MQTT_ACK_TIMEOUT_SECONDS=2.5
# En développement, laisser False quand aucun ESP32 n'est connecté.
# En production sur Raspberry, activer True.
MQTT_ACK_REQUIRED=False
MQTT_PUBLISHED_HOST=127.0.0.1

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost/grafana/

