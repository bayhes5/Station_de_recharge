SECRET_KEY=change-me-in-local-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# En développement local, accepte automatiquement localhost, les IP privées Wi-Fi
# et les noms de services Docker sans devoir modifier l'IP à chaque changement.
# À désactiver en production et à remplacer par ALLOWED_HOSTS explicite.
