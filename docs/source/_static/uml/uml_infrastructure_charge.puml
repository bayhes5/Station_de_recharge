@startuml
' Generated from backend/api/models.py
!pragma layout smetana
skinparam backgroundColor #F8FAFC
skinparam dpi 160
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  FontColor #0F172A
  HeaderBackgroundColor #0F766E
  HeaderFontColor #FFFFFF
}
hide circle
left to right direction

' Infrastructure, réservation et supervision

class Station <<Django model>> {
  +id_station : UUID
  +nom : String
  +localisation_text : String
  +latitude : Float?
  +longitude : Float?
  +statut : StationStatus
}

class Borne <<Django model>> {
  +id_borne : UUID
  +numero : Integer
  +nom : String
  +terminal_code : String?
  +mqtt_prefix : String?
  +statut : BorneStatus
}

class Emplacement <<Django model>> {
  +id_emplacement : UUID
  +numero : Integer
  +statut : EmplacementStatus
  +lock_state : LockState
}

class Reservation <<Django model>> {
  +id_reservation : UUID
  +reference_code : String?
  +auth_choice : ReservationAuthChoice
  +date_debut : DateTime
  +date_fin : DateTime
  +statut : ReservationStatus
}

class Session <<Django model>> {
  +id_session : UUID
  +start_time : DateTime
  +end_time : DateTime?
  +charge_state : ChargeSessionState
  +charge_state_updated_at : DateTime
}

class SessionTelemetry <<Django model>> {
  +id_telemetry : UUID
  +courant : Float
  +tension : Float
  +energie_kwh : Float
  +timestamp : DateTime
}

class Device <<Django model>> {
  +id_device : UUID
  +type_device : DeviceType
  +firmware_version : String
  +expected_firmware_version : String?
  +firmware_update_status : FirmwareUpdateStatus
  +ip_address : IPAddress?
  +slot_id : String?
  +hardware_mac : String?
  +last_seen : DateTime?
  +status : DeviceStatus
}

class DeviceCommandLog <<Django model>> {
  +id_command : UUID
  +command_id : String?
  +action : String?
  +status : String?
  +message : String?
  +source : String?
  +timestamp : DateTime
}

class Capteur <<Django model>> {
  +id_capteur : UUID
  +type : String
  +unite : String
}

class CapteurData <<Django model>> {
  +id_data : UUID
  +valeur : Float
  +timestamp : DateTime
}

class Alerte <<Django model>> {
  +id_alerte : UUID
  +type : String
  +message : Text
  +niveau_severite : AlertSeverity
  +status : AlertStatus
  +timestamp : DateTime
  +first_seen : DateTime
  +last_seen : DateTime
  +notification_count : Integer
  +acknowledged_at : DateTime?
  +resolved_at : DateTime?
}

Station "1" *-- "0..*" Borne : bornes
Station "1" -- "0..*" Emplacement : emplacements
Borne "1" *-- "0..*" Emplacement : emplacements
Emplacement "1" -- "0..*" Reservation : reservations
Reservation "1" *-- "0..1" Session : session
Emplacement "1" -- "0..*" Session : sessions
Session "1" *-- "0..*" SessionTelemetry : telemetries
Emplacement "1" *-- "0..1" Device : device
Device "1" -- "0..*" DeviceCommandLog : command_logs
Session "0..1" -- "0..*" DeviceCommandLog : device_command_logs
Device "0..1" *-- "0..*" Capteur : capteurs
Capteur "1" *-- "0..*" CapteurData : donnees
CapteurData "0..1" -- "0..*" Alerte : alertes
Session "0..1" -- "0..*" Alerte : alertes
@enduml
