@startuml
' Generated from backend/api/models.py
!pragma layout smetana
skinparam backgroundColor #F8FAFC
skinparam dpi 160
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  FontColor #0F172A
  HeaderBackgroundColor #0F766E
  HeaderFontColor #FFFFFF
}
hide circle
left to right direction

' Infrastructure, réservation et supervision

class Station <<Django model>> {
  +nom : String
  +localisation_text : String
  +latitude : Float?
  +longitude : Float?
  +statut : StationStatus
  --
  +__str__() : String
}

class Borne <<Django model>> {
  +numero : Integer
  +nom : String
  +terminal_code : String?
  +mqtt_prefix : String?
  +statut : BorneStatus
  --
  +__str__() : String
  +{static} default_for_station(station) : Borne
}

class Emplacement <<Django model>> {
  +numero : Integer
  +statut : EmplacementStatus
  +lock_state : LockState
  --
  +__str__() : String
  +save() : void
}

class Reservation <<Django model>> {
  +reference_code : String?
  +auth_choice : ReservationAuthChoice
  +date_debut : DateTime
  +date_fin : DateTime
  +statut : ReservationStatus
}

class Session <<Django model>> {
  +start_time : DateTime
  +end_time : DateTime?
  +charge_state : ChargeSessionState
  +charge_state_updated_at : DateTime
}

class SessionTelemetry <<Django model>> {
  +courant : Float
  +tension : Float
  +energie_kwh : Float
  +timestamp : DateTime
}

class Device <<Django model>> {
  +type_device : DeviceType
  +firmware_version : String
  +expected_firmware_version : String?
  +firmware_update_status : FirmwareUpdateStatus
  +ip_address : IPAddress?
  +slot_id : String?
  +hardware_mac : String?
  +last_seen : DateTime?
  +status : DeviceStatus
}

class DeviceCommandLog <<Django model>> {
  +command_id : String?
  +action : String?
  +status : String?
  +message : String?
  +source : String?
  +timestamp : DateTime
}

class Capteur <<Django model>> {
  +type : String
  +unite : String
}

class CapteurData <<Django model>> {
  +valeur : Float
  +timestamp : DateTime
}

class Alerte <<Django model>> {
  +type : String
  +message : Text
  +niveau_severite : AlertSeverity
  +status : AlertStatus
  +timestamp : DateTime
  +first_seen : DateTime
  +last_seen : DateTime
  +notification_count : Integer
  +acknowledged_at : DateTime?
  +resolved_at : DateTime?
}

enum StationStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum BorneStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum EmplacementStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum LockState {
  LOCKED
  UNLOCKED
  BLOCKED
}

enum ReservationAuthChoice {
  RFID
  QR
  CODE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  CANCELLED
  COMPLETED
}

enum ChargeSessionState {
  RESERVED
  ACCESS_VALIDATED
  WAITING_PLUG
  CHARGING
  STOPPING
  STOPPED
  ERROR
}

enum DeviceType {
  ESP32
}

enum DeviceStatus {
  PROVISIONED
  ONLINE
  IDLE
  OFFLINE
  CHARGING
  ERROR
}

enum FirmwareUpdateStatus {
  UNKNOWN
  UP_TO_DATE
  UPDATE_REQUIRED
  UPDATE_SCHEDULED
  UPDATING
  FAILED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  CRITIQUE
}

enum AlertStatus {
  NEW
  ACTIVE
  IN_PROGRESS
  RESOLVED
  CLOSED
  FERMEE
}

Station "1" *-- "0..*" Borne : bornes
Station "1" -- "0..*" Emplacement : emplacements
Borne "1" *-- "0..*" Emplacement : emplacements
Emplacement "1" -- "0..*" Reservation : reservations
Reservation "1" *-- "0..1" Session : session
Emplacement "1" -- "0..*" Session : sessions
Session "1" *-- "0..*" SessionTelemetry : telemetries
Emplacement "1" *-- "0..1" Device : device
Device "1" -- "0..*" DeviceCommandLog : command_logs
Session "0..1" -- "0..*" DeviceCommandLog : device_command_logs
Device "0..1" *-- "0..*" Capteur : capteurs
Capteur "1" *-- "0..*" CapteurData : donnees
CapteurData "0..1" -- "0..*" Alerte : alertes
Session "0..1" -- "0..*" Alerte : alertes
@enduml
