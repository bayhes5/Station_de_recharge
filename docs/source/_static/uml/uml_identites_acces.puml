@startuml
' Generated from backend/api/models.py
!pragma layout smetana
skinparam backgroundColor #F8FAFC
skinparam dpi 160
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #CBD5E1
  FontColor #0F172A
  HeaderBackgroundColor #0F766E
  HeaderFontColor #FFFFFF
}
hide circle
left to right direction

' Identités et accès

class Utilisateur <<Django model>> {
  +pseudo : String
  +email : String
  +password_hash : String
  +statut : UserStatus
  +failed_attempts : Integer
  +must_change_password : Boolean
  +password_reset_at : DateTime?
  +is_active : Boolean
  +is_staff : Boolean
  +date_joined : DateTime
  --
  +__str__() : String
}

class ProfilUtilisateur <<Django model>> {
  +nom : String?
  +telephone : String?
  +telephone_verifie : Boolean
  --
  +__str__() : String
}

class Role <<Django model>> {
  +nom : String
  +description : Text?
  --
  +__str__() : String
}

class UtilisateurRole <<Django model>> {
  +assigned_at : DateTime
  --
  +__str__() : String
}

class Consentement <<Django model>> {
  +type : ConsentType
  +statut : ConsentStatus
  +date_consentement : DateTime
}

class JournalSecurite <<Django model>> {
  +action : String
  +ip : IPAddress
  +statut : SecurityLogStatus
  +date_action : DateTime
}

class TypeAuth <<Django model>> {
  +libelle : String
  +factor_level : Integer
}

class Authentification <<Django model>> {
  +hash_valeur : Text
  +display_value : String?
  +metadata : JSON?
  +expiration : DateTime?
  +is_active : Boolean
  +created_at : DateTime
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ConsentType {
  CGU
  PRIVACY
  NOTIFICATIONS
}

enum ConsentStatus {
  ACCEPTED
  REFUSED
}

enum SecurityLogStatus {
  SUCCESS
  FAILURE
}

Utilisateur "1" *-- "0..1" ProfilUtilisateur : profil
Utilisateur "1" -- "0..*" UtilisateurRole : utilisateur
Role "1" -- "0..*" UtilisateurRole : role
Utilisateur "1" -- "0..*" Consentement : consentements
Utilisateur "0..1" -- "0..*" JournalSecurite : journaux_securite
Utilisateur "1" -- "0..*" Authentification : authentifications
TypeAuth "1" -- "0..*" Authentification : authentifications
@enduml
