          "rawSql": "SELECT COALESCE(NULLIF(d.mac_address, ''), e.numero::text) AS slot, d.status, d.last_seen, e.numero AS emplacement, s.nom AS station\nFROM device d\nJOIN emplacement e ON e.id_emplacement = d.id_emplacement\nJOIN station s ON s.id_station = e.id_station\nORDER BY d.last_seen DESC NULLS LAST;",
