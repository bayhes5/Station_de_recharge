          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT cd.timestamp AS time, cd.valeur AS value, COALESCE(NULLIF(d.mac_address, ''), e.numero::text) AS metric\nFROM capteur_data cd\nJOIN capteur c ON c.id_capteur = cd.id_capteur\nLEFT JOIN device d ON d.id_device = c.id_device\nLEFT JOIN emplacement e ON e.id_emplacement = d.id_emplacement\nWHERE c.type = 'temperature' AND $__timeFilter(cd.timestamp)\nORDER BY cd.timestamp;",
          "refId": "A"
        }
      ],
      "title": "Temperature par emplacement",
      "type": "timeseries"
